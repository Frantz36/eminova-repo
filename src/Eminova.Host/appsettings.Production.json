{
  "Logging": { "LogLevel": { "Default": "Warning" } },

  "Database": {
    "Provider": "PostgreSQL"
  },
  "ConnectionStrings": {
    "Eminova": "Host=<DB-HOST>;Port=5432;Database=eminova;Username=eminova_app;Password=<SECRET>;SSL Mode=Require;Trust Server Certificate=false"
  },

  "Auth": {
    "Authority": "https://id.<CLIENT-DOMAIN>/realms/eminova",
    "ClientId": "eminova-dashboard",
    "ClientSecret": "<SET VIA ENVIRONMENT: Auth__ClientSecret>",
    "NameClaim": "preferred_username"
  },

  "Hosting": {
    "DefaultTenant": "<CLIENT-CODE>",
    "HttpsRedirect": false
  }
}
