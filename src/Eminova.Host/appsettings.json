{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Eminova": "Data Source=App_Data/eminova.db"
  },
  "Auth": {
    "Authority": "",
    "ClientId": "eminova-dashboard",
    "ClientSecret": "",
    "NameClaim": "preferred_username"
  },
  "Hosting": {
    "DefaultTenant": "default",
    "HttpsRedirect": true,
    "StateScope": "tenant"
  }
}