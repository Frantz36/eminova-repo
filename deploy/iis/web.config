<?xml version="1.0" encoding="utf-8"?>
<!-- IIS (Windows Server 2019/2022) — requires the ASP.NET Core 8 Hosting Bundle. `dotnet publish` generates this file;
     this copy shows the settings the playbook relies on. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Eminova.Host.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="Hosting__HttpsRedirect" value="true" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering><requestLimits maxAllowedContentLength="52428800" /></requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
